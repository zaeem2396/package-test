APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Conductor / Orkes (see docs/ECOMMERCE_WORKFLOW_DEMO.md and docs/ORKEES_CLOUD_SETUP.md)
# Local (Docker Compose): CONDUCTOR_SERVER=http://conductor-server:8080/api
# Local (host): e.g. http://127.0.0.1:8090/api
# Orkes Cloud: set CONDUCTOR_SERVER_URL to the API URL from your access key + use key/secret below.
CONDUCTOR_SERVER=http://127.0.0.1:8090/api
# CONDUCTOR_SERVER_URL=https://your-cluster.orkescloud.com/api
# CONDUCTOR_AUTH_KEY=
# CONDUCTOR_AUTH_SECRET=
# CONDUCTOR_AUTH_HEADER_STYLE=bearer
# CONDUCTOR_TOKEN=
CONDUCTOR_TIMEOUT=30
# Handler throws → worker retries before failing task (not Conductor task retries)
CONDUCTOR_WORKER_MAX_RETRIES=0
CONDUCTOR_POLL_INTERVAL=2
CONDUCTOR_RETRY_ENABLED=false
CONDUCTOR_RETRY_MAX_ATTEMPTS=3
CONDUCTOR_RETRY_INITIAL_DELAY_MS=1000
