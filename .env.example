APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (default for this PoC). Create database + user first, or use Docker Compose (mysql service).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=

# Docker Compose: the `app` service injects DB_HOST=mysql, DB_* matching the mysql service — overrides the above inside the container.
# Optional — file DB without MySQL: DB_CONNECTION=sqlite, then `touch database/database.sqlite` (comment out mysql vars).

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use `database` when running `vector:ingest --queue` + `queue:work` (Docker queue-worker uses this).
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Vectora + Pinecone + RAG (see README.md)
# -----------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_API_VERSION=2025-10
PINECONE_CONTROL_PLANE_URL=https://api.pinecone.io
PINECONE_INDEX=default
# PINECONE_NAMESPACE=

# OpenAI (embeddings and/or chat)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# Embeddings: MUST match Pinecone index dimension.
# - openai + text-embedding-3-small → typically 1536-D index
# - deterministic → set PINECONE_EMBEDDING_DETERMINISTIC_DIMENSIONS to index dimension (e.g. 1024)
PINECONE_EMBEDDING_DRIVER=deterministic
PINECONE_EMBEDDING_DETERMINISTIC_DIMENSIONS=8

# RAG chat (Vectora)
VECTORA_LLM_DRIVER=stub
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_TEMPERATURE=0.2
# OPENAI_CHAT_MAX_TOKENS=

# Optional: chunking / RAG defaults (see config/knowledge.php)
# KNOWLEDGE_CHUNK_SIZE=2000
# KNOWLEDGE_CHUNK_OVERLAP=200
# KNOWLEDGE_DEFAULT_TOP_K=5
